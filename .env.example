# Copia este fichero como .env y ajústalo antes de arrancar por primera vez.

# Primer administrador (solo se usa si la base de datos está vacía)
ADMIN_USER=carlos
ADMIN_NAME=Carlos Bosch
ADMIN_PASSWORD=cambia-esta-clave

# Clave para firmar las sesiones. Si se deja vacía se genera y se guarda en /data/secret.key
SECRET_KEY=

# Pon 1 si la app se publica detrás de un proxy con HTTPS (recomendado)
COOKIE_SECURE=0

# Horas que dura la sesión y número de cargas que se guardan en el historial
SESSION_HOURS=12
KEEP_LOADS=30
